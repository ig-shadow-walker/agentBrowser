node_modules/
dist/
build/
release/
*.tgz
.DS_Store

# Compiled binaries are never committed — they ship as GitHub Release assets,
# which live outside the repo. Belt and braces in case one is built elsewhere.
agentbrowser
agentbrowser-darwin-*
SHA256SUMS

# Never commit local credentials or captured browser state.
secrets.json
.env
.env.*
!.env.example
*.log
src/generated/

# Engine binaries copied in as Tauri sidecars (72MB each).
app/src-tauri/binaries/

# Apple signing credentials — never commit.
app/.signing.env

# Certificate enrolment artifacts. The .cer and .certSigningRequest are public
# (no private key), but they do not belong in the repo — and keeping them here
# invites someone to drop the matching .p12 alongside, which WOULD be a leak.
# The private key belongs in the login keychain and nowhere else.
*.certSigningRequest
*.cer
*.p12
*.mobileprovision
