# Copy to .signing.env (gitignored) and fill in. Never commit the real file.
#
#   cp app/.signing.env.example app/.signing.env

# Exactly as `security find-identity -v -p codesigning` prints it, including the
# team id in brackets. Quote it — it contains spaces.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (ABCDE12345)"

# The Apple ID enrolled in the Developer Program.
APPLE_ID="you@example.com"

# An APP-SPECIFIC password from appleid.apple.com, NOT your Apple ID password.
# Sign-In and Security -> App-Specific Passwords -> generate one.
APPLE_PASSWORD="abcd-efgh-ijkl-mnop"

# Your 10-character Team ID, shown at developer.apple.com/account under
# Membership, and in brackets in the signing identity above.
APPLE_TEAM_ID="ABCDE12345"
